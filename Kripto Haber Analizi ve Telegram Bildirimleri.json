        {
            "id": "c6942449-1e0b-4bca-b1e0-411a3deaf26d",
            "name": "Not6",
            "type": "n8n-nodes-base.stickyNote",
            "position": [
                1320,
                840
            ],
            "parameters": {
                "color": 7,
                "width": 260,
                "height": 360,
                "content": "## Yapay Zeka İstemi Hazırla\nFiltre edilmiş makalelerin listesiyle GPT-4o için giriş istemini oluşturur. Çıktı özet, duyarlılık ve makale bağlantılarını içerir."
            },
            "typeVersion": 1
        },
        {
            "id": "7f401bd0-f14d-49d6-9d4a-fcb6e01bd64c",
            "name": "Not7",
            "type": "n8n-nodes-base.stickyNote",
            "position": [
                1640,
                800
            ],
            "parameters": {
                "color": 3,
                "width": 340,
                "height": 440,
                "content": "## Haber ve Duygu Özeti (GPT-4o)\nHaberlerin öz bir özetini oluşturmak, piyasa duyarlılığını analiz etmek ve biçimlendirilmiş sonuçları döndürmek için OpenAI GPT-4o kullanır.\n\n"
            },
            "typeVersion": 1
        },
        {
            "id": "f60cb8e4-8d3f-4112-a200-6affb3b80cb3",
            "name": "Not8",
            "type": "n8n-nodes-base.stickyNote",
            "position": [
                2040,
                760
            ],
            "parameters": {
                "color": 6,
                "height": 460,
                "content": "## Telegram İçin Biçimlendir\n\nYapay zeka özetini çıkarır ve Telegram teslimatı için hazırlar. Diğer verileri dahil etmek istiyorsanız değişkeni değiştirin.\n\n\n"
            },
            "typeVersion": 1
