        {
            "id": "ea8734d6-5f17-4587-88aa-fcd342a563c5",
            "name": "Not4",
            "type": "n8n-nodes-base.stickyNote",
            "position": [
                0,
                0
            ],
            "parameters": {
                "color": 5,
                "width": 460,
                "height": 1980,
                "content": "## Haber Toplayıcılar\nBüyük kripto haber kaynaklarından makaleler çeker. Kapsama alanını genişletmek için burada daha fazla RSS besleme ekleyebilirsiniz."
            },
            "typeVersion": 1
        },
        {
            "id": "214d3fa9-d3f2-4e8a-bfab-5d4deb2881cf",
            "name": "Not5",
            "type": "n8n-nodes-base.stickyNote",
            "position": [
                760,
                680
            ],
            "parameters": {
                "color": 2,
                "width": 480,
                "height": 760,
                "content": "## Haberleri Birleştir ve Filtrele\nTüm RSS makalelerini birleştirir ve yalnızca ilgili sonuçları eşleştirmek için çıkarılan anahtar kelimeyi kullanarak filtreler."
            },
            "typeVersion": 1
