        {
            "id": "a1f53681-504a-445a-9aa1-35c40f174e0c",
            "name": "Sorguya Göre Filtrele",
            "type": "n8n-nodes-base.code",
            "position": [
                1080,
                1020
            ],
            "parameters": {
                "jsCode": "const term = $node[\"Sorgu Ayarla\"].json.query.toLowerCase();\nreturn items.filter(item => {\n  const j            = item.json;\n  const title        = (j.title || \"\").toLowerCase();\n  const snippet      = (j.contentSnippet || j.description || \"\").toLowerCase();\n  const fullContent  = (j.content || \"\").toLowerCase();\n  return title.includes(term)\n      || snippet.includes(term)\n      || fullContent.includes(term);\n});"
            },
            "typeVersion": 2
        },
        {
            "id": "3b886f03-884f-4c9a-bb74-46be78c941fe",
            "name": "İstem Oluştur",
            "type": "n8n-nodes-base.code",
            "position": [
                1400,
                1020
            ],
            "parameters": {
                "jsCode": "const q   = $node[\"Sorgu Ayarla\"].json.query;\nconst list = items\n  .map(i => `- ${i.json.title} (${i.json.link})`)\n  .join(\"\\n\");\nconst prompt = `\nSen bir kripto sektörü haber analistisin.\n**${q}** için güncel haberleri ve piyasa duyarlılığını bu makalelere dayanarak özetle:\n${list}\n\nCevabı 3 bölümde ver:\n1. Haber Özeti\n2. Piyasa Duyarlılığı\n3. Kaynak haber makalelerine bağlantılar\n`;\nreturn [{ json: { prompt } }];"
            },
            "typeVersion": 2
        },
